{
  "name": "backend",
  "version": "1.0.0",
  "description": "TapnBazaar API server",
  "main": "dist/server.js",
 "scripts": {
  "dev": "nodemon --watch src --ext ts --exec ts-node src/server.ts",
  "build": "tsc",
  "start": "node dist/server.js",
  "seed": "ts-node prisma/seed.ts"
},
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
